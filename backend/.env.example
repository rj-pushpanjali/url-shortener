# ---------------------------------------
# Server
# ---------------------------------------
PORT=5000
NODE_ENV=development

# debug | info | warn | error. Logs are one JSON object per line.
LOG_LEVEL=info

# ---------------------------------------
# PostgreSQL
# ---------------------------------------
# Option A: individual fields (used by config/db.js)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=url_shortener

# Option B: single connection string (also supported, see db.js)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/url_shortener

# Public address used to build short links (see utils/buildShortUrl.js).
# Optional: defaults to http://localhost:<PORT>. Set it when users reach the
# app on a different address than the port it listens on (Docker, Nginx).
# BASE_URL=http://localhost:5000

# Optional: adds an "X-Served-By: <name>" response header so you can tell
# which instance answered when several run side by side (demos only).
# INSTANCE_NAME=backend1

# ---------------------------------------
# Redis
# ---------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Option B: single connection string (also supported, see config/redis.js)
# REDIS_URL=redis://localhost:6379

# How long (in seconds) a cached short_code -> long_url mapping stays in
# Redis before it must be re-fetched from PostgreSQL. Configurable per
# requirement #4 — tune this without touching code.
URL_CACHE_TTL_SECONDS=3600

# ---------------------------------------
# Authentication (Stage 5)
# ---------------------------------------
# Secret used to sign JWTs. REQUIRED, at least 32 characters; the server
# refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Every backend instance must use the SAME value (Stage 10+).
JWT_SECRET=
# Token lifetime (no refresh tokens in this project, so keep it modest).
JWT_EXPIRES_IN=1h
# bcrypt cost factor. 10 is the common default; higher is slower/stronger.
BCRYPT_SALT_ROUNDS=10

# ---------------------------------------
# Analytics worker (Stage 7)
# ---------------------------------------
# BullMQ reuses the REDIS_* settings above (same Redis server). Run the
# worker as its own process with:  npm run worker
# How many click jobs one worker process handles at the same time.
WORKER_CONCURRENCY=5

# ---------------------------------------
# Rate limiting (Stage 8)
# ---------------------------------------
# Counters live in the same Redis server as the cache and queue.
# How many reverse proxies sit in front of the app. Leave unset when you run
# the backend directly on your machine. docker-compose.yml sets it to 1,
# because nginx is in front there; without it every user would look like
# nginx's IP and they would all share one limit. Never "true".
# TRUST_PROXY=1

# Optional overrides of the default limits (positive integers). Defaults
# and the reasoning for each are in the README. Lowering one is handy for
# demos, e.g. RATE_LIMIT_LOGIN_MAX=3
# RATE_LIMIT_REGISTER_MAX=5       # per IP, per hour
# RATE_LIMIT_LOGIN_MAX=10         # failed attempts per IP, per 15 minutes
# RATE_LIMIT_CREATE_URL_MAX=30    # per user, per minute
# RATE_LIMIT_API_MAX=120          # per user, per minute (all /api/urls routes)
# RATE_LIMIT_REDIRECT_MAX=300     # per IP, per minute
