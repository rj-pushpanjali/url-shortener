# .env.example  (project root: used by docker-compose.yml)
#
#   cp .env.example .env      then edit .env
#
# .env is git-ignored. Never commit real secrets.
# (backend/.env.example is the separate file for running the backend
#  directly on your machine WITHOUT Docker.)

# --- PostgreSQL (the container creates this user/database on first start) ---
POSTGRES_USER=postgres
POSTGRES_DB=url_shortener
# REQUIRED. Pick your own. Note: it is only applied when the database volume
# is first created; changing it later needs `docker compose down -v` (which
# deletes the data) or an ALTER USER inside Postgres.
POSTGRES_PASSWORD=pushpanjali@2005

# --- Authentication ---
# REQUIRED, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=e08883349d531d4d89000c8ddfeb8d0e65e0c84bcf8423a5d8a259d91ee156c2471dffa7bd91919ec5af38f551a02b3e
JWT_EXPIRES_IN=1h

# --- Public address of the app ---
# Used to build the short links shown in the dashboard. Must be an address
# YOUR BROWSER can reach: nginx's published port. Default shown.
# BASE_URL=http://localhost:5000

# --- Optional tuning (defaults shown) ---
# LOG_LEVEL=info   # debug | info | warn | error (logs are JSON lines)
# BCRYPT_SALT_ROUNDS=10
# URL_CACHE_TTL_SECONDS=3600
# WORKER_CONCURRENCY=5

# Rate limits (see README). Lowering one is handy for demos.
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_CREATE_URL_MAX=30
# RATE_LIMIT_API_MAX=120
# RATE_LIMIT_REDIRECT_MAX=300

# How many reverse proxies sit in front of the backends. docker-compose.yml
# defaults it to 1 (nginx is the one proxy), which makes the per-IP rate
# limits see the real client instead of nginx's address. Set it to an empty
# value to turn it off. Never "true".
# TRUST_PROXY=1
