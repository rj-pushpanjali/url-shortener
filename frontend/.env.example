# Optional. Leave empty in development: requests use relative URLs and the
# Vite dev proxy (see vite.config.js) forwards them to the backend.
# Set this only if the API is served from a different origin (that would
# also require CORS on the backend, which this project does not add).
VITE_API_BASE_URL=

# Where the Vite dev proxy forwards /auth and /api (dev only).
# VITE_BACKEND_URL=http://localhost:5000
