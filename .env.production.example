# .env.production.example
#
#   cp .env.production.example .env      then fill it in on the SERVER
#
# Used together with docker-compose.prod.yml (see DEPLOY.md).
# .env is git-ignored. Never commit real secrets.

# --- Your two host names (DNS A records -> this server's public IP) ---
APP_DOMAIN=app.example.com
SHORT_DOMAIN=go.example.com

# Short links are built from this. It must be the SHORT domain, with https.
BASE_URL=https://go.example.com

# Client IP passes through Caddy and nginx: two proxies. Do not leave this at 1.
TRUST_PROXY=2

# --- Secrets: generate strong values ---
#   openssl rand -hex 24                                              (password)
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"   (JWT secret)
POSTGRES_USER=urlshortener
POSTGRES_DB=url_shortener
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=1h

LOG_LEVEL=info
